<?xml version="1.0" encoding="utf-8"?>
<!-- This calendar month's income and expense totals with cards, net savings
     summary, and total savings banner. Tapping opens the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_month_title"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/widget_text_secondary" />

    <!-- Side-by-side cards: Money in and Money out -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Money In Card -->
        <LinearLayout
            android:id="@+id/widget_month_income_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_card_income"
            android:padding="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_income"
                tools:text="₹45,000.00" />

            <TextView
                android:id="@+id/widget_month_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_month_income_label"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <!-- Money Out Card -->
        <LinearLayout
            android:id="@+id/widget_month_expense_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_card_expense"
            android:padding="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_expense"
                tools:text="₹18,250.00" />

            <TextView
                android:id="@+id/widget_month_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_month_expense_label"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Total balance summary & Total savings banner -->
    <LinearLayout
        android:id="@+id/widget_month_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_banner_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_month_net_savings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            tools:text="Total balance: +₹26,750.00" />

        <TextView
            android:id="@+id/widget_month_total_savings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_secondary"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Total saved: ₹1,50,000" />
    </LinearLayout>
</LinearLayout>
