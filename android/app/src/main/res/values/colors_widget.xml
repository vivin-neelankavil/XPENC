<?xml version="1.0" encoding="utf-8"?>
<!-- Light-mode colours for the home-screen Balance widget. RemoteViews can't
     follow the in-app Material theme (it isn't Compose), so these are fixed
     brand colours instead — see BrandMark's own light/dark inversion for the
     same idea applied in-app. -->
<resources>
    <color name="widget_background">#FFFFFF</color>
    <color name="widget_text_primary">#0E0E10</color>
    <color name="widget_text_secondary">#6B7280</color>
    <color name="widget_chip_background">#F1F1F3</color>
    <color name="widget_chip_text">#0E0E10</color>
    <!-- Same green/red as AppColors.income/expense in-app — brand colours,
         not theme-dependent, so identical in the night variant too. -->
    <color name="widget_income">#16A34A</color>
    <color name="widget_expense">#DC2626</color>
    <color name="widget_card_income_bg">#F0FDF4</color>
    <color name="widget_card_income_stroke">#BBF7D0</color>
    <color name="widget_card_expense_bg">#FEF2F2</color>
    <color name="widget_card_expense_stroke">#FECACA</color>
    <color name="widget_banner_bg">#F3F4F6</color>
    <color name="widget_progress_bg">#E5E7EB</color>
    <color name="widget_progress_fill">#16A34A</color>
    <color name="widget_progress_loan_fill">#2563EB</color>
    <color name="widget_badge_bg">#E5E7EB</color>
    <color name="widget_badge_text">#4B5563</color>
    <color name="widget_card_min_bg">#EEF2FF</color>
    <color name="widget_card_min_stroke">#C7D2FE</color>
    <color name="widget_bar_min_highlight">#3B82F6</color>
    <color name="widget_bar_min_muted">#E0E7FF</color>
    <color name="widget_bar_max_highlight">#EF4444</color>
    <color name="widget_bar_max_muted">#FEE2E2</color>
</resources>
